# Copiá este archivo a .env y completá los valores.

# --- Base de datos ---
# Desarrollo con el contenedor de docker-compose:
DATABASE_URL="postgresql://rumbo:rumbo_dev_2026@localhost:5433/rumbo?schema=public"
# Producción: la cadena de conexión de tu PostgreSQL administrado.

# --- Sesiones ---
# Mínimo 32 caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Usuario administrador que crea `npm run db:seed` ---
SEED_ADMIN_EMAIL="admin@rumbo.app"
SEED_ADMIN_PASSWORD="Admin1234"
SEED_ADMIN_NAME="Administrador"
