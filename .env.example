# Plantilla de variables. Copiala a `.env` y reemplazá cada `CAMBIAR-ESTO`.
#
#   cp .env.example .env
#
# Ningún valor de este archivo sirve tal cual: son marcadores, no credenciales.
# `.env` no se versiona.

# --- Base de datos ---
#
# La contraseña tiene que coincidir con POSTGRES_PASSWORD de docker-compose.yml.
# Para desarrollo local con el contenedor del proyecto:
#   postgresql://rumbo:<la de docker-compose>@localhost:5433/rumbo?schema=public
#
# En producción, la cadena de tu PostgreSQL administrado (Neon, Supabase, VPS…).
DATABASE_URL="postgresql://USUARIO:CAMBIAR-ESTO@localhost:5433/rumbo?schema=public"

# --- Sesiones ---
#
# Firma las cookies de sesión. Mínimo 32 caracteres y distinta en cada entorno:
# si se filtra, cualquiera puede fabricar sesiones válidas.
#
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CAMBIAR-ESTO-minimo-32-caracteres"

# --- Usuario administrador inicial que crea `npm run db:seed` ---
#
# Es la primera cuenta con acceso total al sistema. Cambiá la contraseña antes
# de cualquier despliegue: dejarla en un valor conocido equivale a no tener
# contraseña.
SEED_ADMIN_EMAIL="admin@tu-empresa.com"
SEED_ADMIN_PASSWORD="CAMBIAR-ESTO"
SEED_ADMIN_NAME="Administrador"
