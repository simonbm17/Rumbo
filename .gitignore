# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo las plantillas (.env.example, .env.test.example), que sí deben
# viajar con el repositorio: son la única documentación de qué variables hacen
# falta para levantar el proyecto y para correr las pruebas.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploads subidos por el usuario (se conservan solo los de la demo)
/public/uploads/*
!/public/uploads/demo/

# Herramientas de agentes copiadas por el editor. No son código del proyecto:
# sin esto, el primer commit son 213 archivos de skills y 116 de código real.
.claude/
.windsurf/
.agents/
skills-lock.json

# Salida de las pruebas
/coverage

# Respaldos de PostgreSQL. Hoy viven fuera del repositorio, pero la regla
# evita que un `pg_dump` lanzado desde la raíz termine en un commit.
*.dump
*.sql.gz
